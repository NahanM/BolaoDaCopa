# Firebase atual / produção
# Projeto Firebase principal usado pelo site em produção.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="bolaodacopa-90a57.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="bolaodacopa-90a57"
VITE_FIREBASE_STORAGE_BUCKET="bolaodacopa-90a57.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID"

# Banco Firestore usado pela aplicação principal.
# Use "(default)" para o banco padrão do projeto Firebase.
VITE_FIREBASE_DATABASE_ID="(default)"

# E-mails que visualizam o painel administrativo no frontend.
# A autorização real também depende das Firestore Security Rules.
VITE_ADMIN_EMAILS="admin@example.com"

# Compatibilidade temporária com a versão antiga.
VITE_ADMIN_EMAIL="admin@example.com"

# Firebase legado / banco antigo
# Projeto usado antes da migração. Não é usado pelo fluxo normal do app.
# Mantenha comentado, exceto se precisar executar uma conferência ou importação manual.
# VITE_OLD_FIREBASE_API_KEY="YOUR_OLD_FIREBASE_API_KEY"
# VITE_OLD_FIREBASE_AUTH_DOMAIN="testebolao2.firebaseapp.com"
# VITE_OLD_FIREBASE_PROJECT_ID="testebolao2"
# VITE_OLD_FIREBASE_STORAGE_BUCKET="YOUR_OLD_STORAGE_BUCKET"
# VITE_OLD_FIREBASE_MESSAGING_SENDER_ID="YOUR_OLD_SENDER_ID"
# VITE_OLD_FIREBASE_APP_ID="YOUR_OLD_FIREBASE_APP_ID"
# VITE_OLD_FIREBASE_DATABASE_ID="(default)"

# Firebase Emulator Suite
# VITE_FIREBASE_EMULATOR_HOST="127.0.0.1:8080"
# VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"